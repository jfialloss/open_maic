rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Carpeta de archivos PDF base para los cursos generados
    match /source_pdfs/{userId}/{fileName} {
      // Solo el usuario dueño puede leer sus PDFs originales y subir nuevos
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Carpeta de Media (Imágenes generadas, Audio TTS) para cursos
    match /courses_media/{classroomId}/{fileName} {
      // Cualquiera autenticado puede leer para ver los cursos
      allow read: if request.auth != null;
      // Solo el creador original o un administrador puede modificar archivos del curso
      allow write: if request.auth != null && (
        firestore.get(/databases/(default)/documents/global_classrooms/$(classroomId)).data.createdBy == request.auth.uid || 
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Carpeta de Audio (TTS pregenerados) para cursos
    match /courses_audio/{classroomId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        firestore.get(/databases/(default)/documents/global_classrooms/$(classroomId)).data.createdBy == request.auth.uid || 
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Denegar el resto
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
