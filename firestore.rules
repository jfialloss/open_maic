rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Obtener rol de forma segura
    function getRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) 
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role 
        : 'none';
    }

    // Función de validación de admin global
    function isAdmin() {
      return request.auth != null && getRole() == 'admin';
    }

    // Función de validación de staff (admin o tutor)
    function isStaff() {
      return request.auth != null && (getRole() == 'admin' || getRole() == 'tutor');
    }

    // Perfil de Usuario y Progreso (Solo el dueño puede leer y escribir, incluyendo subcolecciones)
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isStaff());
      allow write: if request.auth != null && (request.auth.uid == userId || isStaff());
      
      match /{document=**} {
        allow read: if request.auth != null && (request.auth.uid == userId || isStaff());
        allow write: if request.auth != null && (request.auth.uid == userId || isStaff());
      }
    }

    // Configuraciones del Sistema
    match /system/{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Biblioteca Global de Cursos
    match /global_classrooms/{classroomId} {
      // Cualquiera autenticado puede leer para descargar cursos
      allow read: if request.auth != null;
      
      // Solo administradores o el creador del curso pueden escribir o borrar
      allow create, update: if request.auth != null && (
        request.auth.uid == request.resource.data.createdBy || 
        isAdmin()
      );
      
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.createdBy || 
        isAdmin()
      );
    }

    // Auditoría de Prompts
    match /prompt_logs/{document=**} {
      allow read: if isStaff();
      allow write: if false; // Solo el backend (Admin SDK) escribe aquí
    }

    // Auditoría de Uso de IA (Tokens y Costos)
    match /usage_logs/{document=**} {
      allow read: if isStaff();
      allow write: if false; // Solo el backend (Admin SDK) escribe aquí
    }

    // Rastreo de Sesiones de Usuario
    match /user_sessions/{sessionId} {
      // El dueño de la sesión puede crearla y actualizarla
      allow create, update: if request.auth != null && request.auth.uid == request.resource.data.uid;
      
      // Solo el dueño o el staff pueden leer las sesiones
      allow read: if request.auth != null && (
        isStaff() || request.auth.uid == resource.data.uid
      );
    }

    // Por defecto, denegar todo lo demás
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
