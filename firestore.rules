rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Perfil de Usuario y Progreso (Solo el dueño puede leer y escribir, incluyendo subcolecciones)
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && request.auth.uid == userId;
      
      match /{document=**} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Configuraciones del Sistema
    match /system/{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Biblioteca Global de Cursos
    match /global_classrooms/{classroomId} {
      // Cualquiera autenticado puede leer para descargar cursos
      allow read: if request.auth != null;
      
      // Solo administradores o el creador del curso pueden escribir o borrar
      // NOTA: Para producción idealmente verificar un custom claim `request.auth.token.role == 'admin'`
      // O verificar que el uid del usuario sea el creador `request.resource.data.createdBy == request.auth.uid`
      allow create, update: if request.auth != null && (
        request.auth.uid == request.resource.data.createdBy || 
        isAdmin()
      );
      
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.createdBy || 
        isAdmin()
      );
    }

    // Función de validación de admin global
    function isAdmin() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Auditoría de Prompts
    match /prompt_logs/{document=**} {
      allow read: if isAdmin();
      allow write: if false; // Solo el backend (Admin SDK) escribe aquí
    }

    // Rastreo de Sesiones de Usuario
    match /user_sessions/{sessionId} {
      // El dueño de la sesión puede crearla y actualizarla
      allow create, update: if request.auth != null && request.auth.uid == request.resource.data.uid;
      
      // Solo el dueño o los administradores pueden leer las sesiones
      allow read: if request.auth != null && (
        isAdmin() || request.auth.uid == resource.data.uid
      );
    }

    // Por defecto, denegar todo lo demás
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
